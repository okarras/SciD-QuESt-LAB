# Evaluation Configuration
# Copy this to .env and configure your settings

# Backend Service Configuration
BACKEND_URL=http://localhost:5001

# Model (OpenRouter vendor/model format)
# Browse models: https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini

# AI Generation Parameters
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2000

# Evaluation Configuration
DEFAULT_DATASET_PATH=../dataset
DEFAULT_OUTPUT_FILE=frontend-exact-results.json
DEFAULT_LIMIT=10

# BERTScore Configuration
USE_BERTSCORE=false
BERTSCORE_MODEL=bert-base-uncased

# Debug Configuration
DEBUG_MODE=false
VERBOSE_LOGGING=true
CAPTURE_FULL_PROMPTS=true

# Performance Configuration
REQUEST_TIMEOUT=30000
RETRY_ATTEMPTS=3
RETRY_DELAY=1000

# Authentication (for backend dev mode)
DEV_USER_ID=evaluation-system
DEV_USER_EMAIL=evaluation@benchmark.local
