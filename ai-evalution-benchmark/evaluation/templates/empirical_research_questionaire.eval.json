{
  "template_id": "R186708",
  "version": "1.0",
  "evaluation": {
    "system_prompt": "You are an AI assistant helping researchers extract information from academic papers. Analyze the provided PDF content and answer the specific question.\n\nThe PDF content is organized by pages (e.g., [PAGE 1], [PAGE 3]). Use these markers to cite the exact source of your evidence.\n\nProvide exactly 3 suggestions, ranked strictly by how likely each is to be the correct answer:\n- Rank 1 MUST be your single best, most-supported answer — the one you would commit to if you could give only one.\n- Ranks 2 and 3 are genuinely plausible alternatives, in decreasing order of likelihood. Never place a weaker answer at rank 1.\n\nAnswer format:\n- If the question lists \"Available Options\", every answer MUST be exactly one of those options (verbatim, same casing).\n- For yes/no questions, answer \"yes\" or \"no\".\n- For free-text answers, prefer the paper's own wording and keep it concise.\n\nConfidence reflects evidence strength: 0.9 = explicitly stated in the paper, 0.5 = inferred, 0.2 = weak guess.\n\nEvidence: EVERY suggestion — including ranks 2 and 3 — must include at least one evidence item: the exact page number(s) from the [PAGE N] markers and a verbatim excerpt (10-50 words) copied word-for-word from the PDF. Never return an empty evidence list. The excerpt is used to highlight text in the PDF viewer, so it must match exactly.\n\nGenerate exactly 3 suggestions in the following JSON format (output ONLY this JSON):\n{\n  \"suggestions\": [\n    {\n      \"rank\": 1,\n      \"text\": \"suggested answer\",\n      \"confidence\": 0.95,\n      \"evidence\": [\n        {\n          \"pageNumber\": 3,\n          \"excerpt\": \"exact text copied from page 3 without modifications\"\n        }\n      ]\n    }\n  ]\n}",
    "suggestions_count": 3,
    "temperature": 0.3,
    "max_tokens": 4000,
    "batch_max_tokens": 0
  },
  "metrics": {
    "text": { "metric": "bertscore", "threshold": 0.7 },
    "single_select": { "metric": "exact_match", "threshold": 1.0 },
    "boolean": { "metric": "exact_match", "threshold": 1.0 },
    "multi_select": { "metric": "f1", "threshold": 0.75 },
    "repeat_text": { "metric": "bertscore_best_match", "threshold": 0.7 },
    "select": { "metric": "exact_match", "threshold": 1.0 },
    "text_object": { "metric": "exact_match", "threshold": 1.0 },
    "url": { "metric": "exact_match", "threshold": 1.0 }
  },
  "skip_questions": [
    "contact_email",
    "doi",
    "data_urls",
    "answer_highlighted",
    "descriptive_stats_used",
    "inferential_stats_used",
    "ml_used"
  ],
  "skip_types": ["url", "repeat_group", "group"],
  "ground_truth_mappings": {
    "research_paradigm": {
      "path": ["questionnaire_data", "research_paradigm"],
      "transform": "direct"
    },
    "research_questions_list": {
      "path": ["questionnaire_data", "research_questions"],
      "transform": "custom",
      "config": {
        "custom_id": "research_questions_list"
      }
    },
    "data_collection_methods": {
      "path": ["questionnaire_data", "data_collection", "methods"],
      "transform": "array_field",
      "config": { "field": "name" }
    },
    "data_type": {
      "path": ["questionnaire_data", "data_collection", "data_type"],
      "transform": "ensure_array"
    },
    "analysis_methods": {
      "path": ["questionnaire_data", "data_analysis"],
      "transform": "analysis_methods_aggregate"
    },
    "descriptive_stats_used": {
      "path": ["questionnaire_data", "data_analysis", "descriptive"],
      "transform": "array_non_empty_boolean"
    },
    "measures_frequency": {
      "path": ["questionnaire_data", "data_analysis", "descriptive_measures", "frequency"],
      "transform": "filter_array"
    },
    "measures_central": {
      "path": ["questionnaire_data", "data_analysis", "descriptive_measures", "central_tendency"],
      "transform": "filter_array"
    },
    "measures_dispersion": {
      "path": ["questionnaire_data", "data_analysis", "descriptive_measures", "dispersion"],
      "transform": "filter_array"
    },
    "measures_position": {
      "path": ["questionnaire_data", "data_analysis", "descriptive_measures", "position"],
      "transform": "filter_array"
    },
    "inferential_stats_used": {
      "path": ["questionnaire_data", "data_analysis", "inferential"],
      "transform": "array_non_empty_boolean"
    },
    "statistical_tests": {
      "path": ["questionnaire_data", "data_analysis", "statistical_tests"],
      "transform": "filter_array"
    },
    "ml_used": {
      "path": ["questionnaire_data", "data_analysis", "machine_learning"],
      "transform": "array_non_empty_boolean"
    },
    "ml_algorithms": {
      "path": ["questionnaire_data", "data_analysis", "ml_algorithms"],
      "transform": "filter_array"
    },
    "ml_metrics": {
      "path": ["questionnaire_data", "data_analysis", "ml_metrics"],
      "transform": "filter_array"
    },
    "other_analysis_used": {
      "path": ["questionnaire_data", "data_analysis", "other_methods"],
      "transform": "array_non_empty_boolean"
    },
    "other_analysis_methods": {
      "path": ["questionnaire_data", "data_analysis", "other_methods"],
      "transform": "filter_array"
    },
    "threats_reported": {
      "path": ["questionnaire_data", "threats_to_validity"],
      "transform": "flags_to_list",
      "config": {
        "external": "external validity",
        "internal": "internal validity",
        "construct": "construct validity",
        "conclusion": "conclusion validity",
        "reliability": "reliability",
        "generalizability": "generalizability",
        "repeatability": "repeatability",
        "content_validity": "content validity",
        "descriptive_validity": "descriptive validity",
        "theoretical_validity": "theoretical validity"
      }
    },
    "threats_mentioned_uncategorized": {
      "path": ["questionnaire_data", "threats_to_validity", "mentioned_uncategorized"],
      "transform": "truthy_to_yes_no"
    },
    "answer_highlighted": {
      "path": ["questionnaire_data", "answer_highlighted"],
      "transform": "truthy_to_yes_no"
    },
    "answer_hidden": {
      "path": ["questionnaire_data", "answer_hidden"],
      "transform": "truthy_to_yes_no"
    },
    "data_urls": {
      "path": ["questionnaire_data", "data_collection", "data_urls"],
      "transform": "filter_array"
    },
    "rq_text": {
      "path": ["questionnaire_data", "research_questions"],
      "transform": "first_item_field",
      "config": { "field": "question" }
    },
    "rq_highlighted": {
      "path": ["questionnaire_data", "research_questions"],
      "transform": "first_item_boolean_field",
      "config": { "field": "highlighted_question" }
    },
    "rq_hidden": {
      "path": ["questionnaire_data", "research_questions"],
      "transform": "first_item_boolean_field",
      "config": { "field": "hidden" }
    },
    "rq_type": {
      "path": ["questionnaire_data", "research_questions"],
      "transform": "first_item_field",
      "config": { "field": "type" }
    },
    "subq_text": {
      "path": ["questionnaire_data", "research_questions"],
      "transform": "nested_first_item_field",
      "config": { "nested_field": "subquestions", "field": "question" }
    },
    "subq_type": {
      "path": ["questionnaire_data", "research_questions"],
      "transform": "nested_first_item_field",
      "config": { "nested_field": "subquestions", "field": "type" }
    },
    "method_type": {
      "path": ["questionnaire_data", "data_collection", "methods"],
      "transform": "first_item_field",
      "config": { "field": "type" }
    },
    "method_name_custom": {
      "path": ["questionnaire_data", "data_collection", "methods"],
      "transform": "first_item_field",
      "config": { "field": "name" }
    },
    "hypothesis_statement": {
      "path": ["questionnaire_data", "data_analysis", "hypotheses"],
      "transform": "join_array_field",
      "config": { "field": "statement", "separator": " | " }
    },
    "hypothesis_type": {
      "path": ["questionnaire_data", "data_analysis", "hypotheses"],
      "transform": "join_array_field",
      "config": { "field": "type", "separator": " | " }
    }
  },
  "sibling_dependencies": {
    "rq_text": [],
    "rq_highlighted": ["rq_text"],
    "rq_hidden": ["rq_text", "rq_highlighted"],
    "rq_type": ["rq_text", "rq_highlighted", "rq_hidden"],
    "subq_text": ["rq_text", "rq_highlighted", "rq_hidden", "rq_type"],
    "subq_type": ["rq_text", "rq_highlighted", "rq_hidden", "rq_type", "subq_text"],
    "answer_highlighted": [],
    "answer_hidden": ["answer_highlighted"],
    "method_type": [],
    "method_name_custom": ["method_type"],
    "data_type": [],
    "data_urls": ["data_type"],
    "descriptive_stats_used": [],
    "measures_frequency": ["descriptive_stats_used"],
    "measures_central": ["descriptive_stats_used", "measures_frequency"],
    "measures_dispersion": ["descriptive_stats_used", "measures_frequency", "measures_central"],
    "measures_position": ["descriptive_stats_used", "measures_frequency", "measures_central", "measures_dispersion"],
    "inferential_stats_used": [],
    "hypothesis_statement": ["inferential_stats_used"],
    "hypothesis_type": ["inferential_stats_used", "hypothesis_statement"],
    "statistical_tests": ["inferential_stats_used", "hypothesis_statement", "hypothesis_type"],
    "ml_used": [],
    "ml_algorithms": ["ml_used"],
    "ml_metrics": ["ml_used", "ml_algorithms"],
    "other_analysis_used": [],
    "other_analysis_methods": ["other_analysis_used"],
    "threats_reported": [],
    "threats_mentioned_uncategorized": ["threats_reported"]
  }
}
